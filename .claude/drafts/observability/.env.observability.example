# Фрагмент для .env.example проекта — только то, что нужно стенду демо 4.
# Секреты БЕЗ значений: пустая переменная лучше «безопасного» дефолта.

# --- профили compose ---
# core — Dagster + MLflow (демо 1-3); observability добавляет Grafana-стек.
COMPOSE_PROFILES=core
# Влияет на фильтр discovery.docker в alloy/config.alloy.
COMPOSE_PROJECT_NAME=02-dagster

# --- образы ---
APP_IMAGE=olist_ml:local
EXPORTER_IMAGE=olist_ml_exporter:local
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.1

# --- порты (5000 на macOS занят AirPlay, поэтому MLflow на 5001) ---
DAGSTER_PORT=3111
MLFLOW_PORT=5001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
EXPORTER_PORT=9101

# --- Postgres: хранилище Dagster (runs / event_log / schedules) ---
POSTGRES_USER=dagster
POSTGRES_DB=dagster
POSTGRES_PORT=5432
POSTGRES_PASSWORD=

# --- MLflow ---
MLFLOW_EXPERIMENT=olist_ml
MLFLOW_METRICS=roc_auc
# Обязательно: в MLflow 3.x включена проверка заголовка Host, и запрос
# с Host: mlflow:5001 из соседнего контейнера иначе получает 403.
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5001,localhost,localhost:5001,127.0.0.1,127.0.0.1:5001

# --- экспортер ---
EXPORTER_POLL_SECONDS=15

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
PROM_RETENTION=24h

# --- алерты ---
# ALERTS_ENABLED=true включает «уровень 0» — run_failure_sensor шлёт в Telegram сам.
ALERTS_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
# Порог quality gate. ВНИМАНИЕ: продублирован числом в
# grafana/provisioning/alerting/rules.yml (Grafana не подставляет переменные
# в числовые поля) — менять в двух местах.
MODEL_METRIC_THRESHOLD=0.7
FRESHNESS_MAX_AGE_SECONDS=900
