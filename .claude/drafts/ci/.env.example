# Несекретная конфигурация демо 02-dagster. `make env` копирует этот файл в
# .env (cp -n — не перезаписывает существующий). Тот же .env читают: Makefile
# (`-include .env`), settings.py (pydantic-settings, env_file=".env") и dbt
# (profiles.yml через env_var). Один файл — один источник правды.
#
# Составные значения (URL из host+port+scheme, MLFLOW_TRACKING_URI и т.п.) сюда
# НЕ пишутся — их собирает src/olist_ml/settings.py (computed_field), см. правило
# «никаких скаляров в коде» в PROMPT.md.
#
# Секреты (KAGGLE_*, TG_BOT_TOKEN, TG_CHAT_ID) — только пустые значения.
# Настоящие значения — в локальном .env, который не коммитится (.gitignore).

# --- Dagster ---
DAGSTER_SCHEME=http
DAGSTER_HOST=127.0.0.1
# 3000 — дефолтный порт Dagster, на машине лектора часто занят другим проектом;
# нестандартный порт, чтобы не драться с чужим `dg dev`.
DAGSTER_PORT=3111
DAGSTER_HOME=.dagster_home

# --- DuckDB / dbt ---
# ВАЖНО: каталог DuckDB называется по имени файла БД — data/olist.duckdb даёт
# каталог `olist`; dbt sources (models/sources/sources.yml) ссылаются на него
# по имени `olist`, а не по DUCKDB_PATH. Переименование файла ломает sources.
DUCKDB_PATH=data/olist.duckdb
DBT_PROJECT_DIR=dbt
# profiles.yml коммитится внутри dbt/ (секретов там нет), поэтому по умолчанию
# совпадает с DBT_PROJECT_DIR — как в mlinside-hw-olist/dbt.
DBT_PROFILES_DIR=dbt
DBT_TARGET_PATH=dbt/target
DBT_TARGET=duck

# --- данные / Kaggle ---
DATA_DIR=data/raw
# Kaggle-токен — аккаунтный, не проектный: в CI не используется, только фикстуры.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=olistbr/brazilian-ecommerce
KAGGLEHUB_CACHE=.kagglehub_cache

# --- сэмплирование / ML ---
SAMPLE_FRAC=0.2
RANDOM_STATE=42
# TODO(ml-лейн): подтвердить порог по факту обучения на сэмпле; 0.60 — заглушка.
ML_GATE_ROC_AUC=0.60

# --- MLflow ---
MLFLOW_HOST=127.0.0.1
# 5000 на macOS занят системным AirPlay Receiver — берём 5001.
MLFLOW_PORT=5001
MLFLOW_DB_PATH=mlflow.db
MLFLOW_ARTIFACTS_DIR=mlruns
MLFLOW_EXPERIMENT=olist_ml
MLFLOW_MODEL_NAME=olist_late_delivery

# --- интеграции / алерты ---
# yaml — DbtProjectComponent/DltLoadCollectionComponent (defs.yaml), основной
# путь по решению лектора; python — @dbt_assets/@dlt_assets, для сравнения.
INTEGRATIONS_STYLE=yaml
# По умолчанию выключено — сенсор работает в dry-run (печатает, не шлёт).
ALERTS_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- freshness (dbt source freshness / Dagster freshness checks), минуты ---
FRESHNESS_WARN_MIN=10
FRESHNESS_FAIL_MIN=30

# --- Postgres (docker compose, ТОЛЬКО демо-стенд — не прод-секреты) ---
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster_demo
POSTGRES_DB=dagster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- observability: Grafana/Prometheus/Loki (docker compose, демо-значения) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
