# Несекретная конфигурация демо 02-dagster. `just env` копирует этот файл в .env (не перезаписывает).
# Тот же .env читают Justfile (`set dotenv-load`), src/olist_ml/settings.py (pydantic-settings) и dbt
# (profiles.yml через env_var). Один файл — один источник правды (ADR-09).
#
# Составные значения (URL, MLFLOW_TRACKING_URI, models:/…@alias, каталог DuckDB) сюда не пишутся —
# их собирает settings.py. Секреты — только пустые значения; настоящие — в локальном .env (.gitignore).

# --- Dagster ---
DAGSTER_SCHEME=http
DAGSTER_HOST=127.0.0.1
DAGSTER_PORT=3000
# DAGSTER_HOME задаёт Justfile (абсолютный путь внутри проекта). Здесь НЕ задавать: dagster CLI
# (`dg dev`/`dg launch`) подгружает .env из cwd поверх окружения, и относительный путь ломает запуск.

# --- данные / DuckDB / dbt ---
DATA_DIR=data
# Каталог DuckDB называется по имени файла: data/olist.duckdb → `olist`; dbt sources ссылаются на `olist`.
DUCKDB_PATH=data/olist.duckdb
RAW_SCHEMA=raw
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
DBT_TARGET_PATH=dbt/target
DBT_TARGET=duck

# --- snapshot / сэмплирование (ADR-03) ---
SNAPSHOT_N_ORDERS=5000
FIXTURES_N_ORDERS=500
RANDOM_STATE=42

# --- ML (ADR-06, ADR-07, ADR-13) ---
ML_DATA_DIR=data/ml
ML_TEST_FRAC=0.2
# Порог gate измерен на shipped snapshot (scripts/measure_gate.py): LogReg, 5 сидов, ROC AUC 0.629–0.689 → min − 0.02.
ML_MIN_ROC_AUC=0.61
ML_SCORE_THRESHOLD=0.5
# Сид baseline-версии из demo-prepare (ADR-07a, вариант A): отличается от RANDOM_STATE, чтобы fingerprint не совпал.
ML_BASELINE_RANDOM_STATE=7
SCORING_BATCH_ID=demo-batch-001

# --- MLflow ---
MLFLOW_HOST=127.0.0.1
# 5000 на macOS занят системным AirPlay Receiver.
MLFLOW_PORT=5001
MLFLOW_DB_PATH=data/mlflow.db
MLFLOW_ARTIFACTS_DIR=data/mlruns
MLFLOW_EXPERIMENT=olist_ml
MLFLOW_MODEL_NAME=olist_late_delivery
MLFLOW_MODEL_ALIAS=champion
# Непустое значение переключает tracking на сервер (например, в compose); пусто — SQLite по MLFLOW_DB_PATH.
MLFLOW_TRACKING_URI=

# --- freshness (ADR-17), минуты ---
FRESHNESS_WARN_MIN=10
FRESHNESS_FAIL_MIN=30

# --- алерты (ADR-18): по умолчанию dry-run — сенсор печатает, не шлёт ---
ALERTS_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
