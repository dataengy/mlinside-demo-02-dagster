*.bak*

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Data / build artifacts
*.duckdb
*.duckdb.wal
data/raw/
target/
dbt_packages/
logs/
.dagster_home/
mlruns/

# Secrets
.env
.env.*
!.env.example

# Agentic runtime state
.ai/.locks/
.ai/.brd-state*

# IDE
.idea/
.DS_Store

# Локальные данные и артефакты (snapshot seeds живут в dbt/seeds/, не здесь)
# data/* вместо data/ — иначе git не заходит внутрь каталога и !data/README.md ниже не работает.
data/*
!data/README.md

# Черновики/scratch, не для коммита (попали в git через автосейв-коммит 2026-09-22, вычищено)
.a-temp-*-from-scratch-/
.claude/.tmp/
.claude/-Users-*
